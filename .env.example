# Clip Autopilot configuration. Copy to .env.local for local development, and add the same
# names in Vercel → Project → Settings → Environment Variables for production.
# See SETUP.md for where each value comes from.

# ---- Basics (required) ----
APP_URL=http://localhost:3000
# Random 32+ characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Exactly 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Encrypts the YouTube/Instagram tokens in the database. Never change it after members connect.
ENCRYPTION_KEY=
# You: the admin. Opens the Admin panel, approves who may sign in, gets the daily summary (required).
ADMIN_EMAIL=you@example.com
# Optional starting list of people who may sign in (comma-separated). Everyone else asks for access
# by signing in with Google, and the admin approves them in the Admin panel.
ALLOWED_EMAILS=

# ---- Safety switch ----
# true = YouTube and Instagram are simulated; nothing is posted. Set to false to go live.
DRY_RUN=true

# ---- Database (Neon Postgres). Empty = local database in .data/db (development only) ----
DATABASE_URL=

# ---- Google (team login + YouTube) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Instagram (Meta app, "Instagram API with Instagram login") ----
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_API_VERSION=v25.0

# ---- Clip storage: pick ONE. Both empty = local disk (development only) ----
# Option A (free, no card): Vercel Blob. Vercel adds this automatically when you connect a Blob store.
BLOB_READ_WRITE_TOKEN=
# Option B: Cloudflare R2 or any S3-compatible bucket (used instead of Blob when filled in).
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# ---- AI for titles/captions and weekly suggestions (SETUP.md step 5b). Gemini is used when set ----
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# Optional alternative, used only without a Gemini key:
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5

# ---- Email (Resend). Empty = emails are printed to the server log ----
RESEND_API_KEY=
EMAIL_FROM=Clip Autopilot <onboarding@resend.dev>

# ---- Scheduler ----
# Random secret. The cron service calls /api/cron/tick every minute with
# the header "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
