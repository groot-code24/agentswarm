# Clip Autopilot configuration. Copy to .env.local for local development, and add the same
# names in Vercel → Project → Settings → Environment Variables for production.
# See SETUP.md for where each value comes from.

# ---- Basics (required) ----
APP_URL=http://localhost:3000
# Random 32+ characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Exactly 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Encrypts the YouTube/Instagram tokens in the database. Never change it after members connect.
ENCRYPTION_KEY=
# Team members who may sign in (comma-separated).
ALLOWED_EMAILS=you@example.com,teammate@example.com
# Gets the daily summary email (optional).
ADMIN_EMAIL=

# ---- Safety switch ----
# true = YouTube and Instagram are simulated; nothing is posted. Set to false to go live.
DRY_RUN=true

# ---- Database (Neon Postgres). Empty = local database in .data/db (development only) ----
DATABASE_URL=

# ---- Google (team login + YouTube) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Instagram (Meta app, "Instagram API with Instagram login") ----
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_API_VERSION=v25.0

# ---- Clip storage (Cloudflare R2 or any S3-compatible bucket). Empty = local disk (development only) ----
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# ---- Email (Resend). Empty = emails are printed to the server log ----
RESEND_API_KEY=
EMAIL_FROM=Clip Autopilot <onboarding@resend.dev>

# ---- Scheduler ----
# Random secret. The cron service calls /api/cron/tick every minute with
# the header "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
